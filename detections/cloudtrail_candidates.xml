<!-- Native rules for the supported Wazuh AWS S3 collector.
     These are investigation candidates, not full semantic D01-D06 coverage. -->
<group name="cloud_breach_candidates,aws,">
  <rule id="110100" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^aws$</field>
    <description>CloudTrail lab input</description>
  </rule>
  <rule id="110101" level="12">
    <if_sid>110100</if_sid>
    <field name="aws.userIdentity.type">^Root$</field>
    <description>Root activity: verify success, service context and authorization (v0.1.0)</description>
  </rule>
  <rule id="110102" level="5">
    <if_sid>110100</if_sid>
    <field name="aws.eventName">^ConsoleLogin$</field>
    <field name="aws.responseElements.ConsoleLogin">^Failure$</field>
    <description>Failed console login: investigate related success (v0.1.0)</description>
  </rule>
  <rule id="110103" level="8">
    <if_sid>110100</if_sid>
    <field name="aws.eventName">^CreateAccessKey$</field>
    <description>Access-key creation attempt: verify actor, target and result (v0.1.0)</description>
  </rule>
  <rule id="110104" level="8">
    <if_sid>110100</if_sid>
    <field name="aws.eventName" type="pcre2">^(Attach(User|Role|Group)Policy|Put(User|Role|Group)Policy)$</field>
    <description>Permission change attempt: inspect effective policy and result (v0.1.0)</description>
  </rule>
  <rule id="110105" level="10">
    <if_sid>110100</if_sid>
    <field name="aws.eventName" type="pcre2">^(StopLogging|DeleteTrail|UpdateTrail)$</field>
    <description>Trail configuration change: verify result and lost coverage (v0.1.0)</description>
  </rule>
  <rule id="110106" level="8">
    <if_sid>110100</if_sid>
    <field name="aws.eventName" type="pcre2">^(PutBucketPolicy|PutBucketPublicAccessBlock|DeleteBucketPublicAccessBlock|PutPublicAccessBlock|DeletePublicAccessBlock)$</field>
    <description>S3 access-control change: effective exposure unknown (v0.1.0)</description>
  </rule>
</group>
